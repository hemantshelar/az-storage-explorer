<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AzStorageExplorer.Views.BlobStorageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzStorageExplorer.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    
    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{StaticResource AppHighlightBrush}" />
            <TextBlock Text="Blob Storage Explorer" 
                       FontSize="24" 
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
        
        <!-- Connection Settings -->
        <controls:Expander Grid.Row="1" 
                           Header="Connection Settings" 
                           IsExpanded="True"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           Margin="0,0,0,16">
            <Grid Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBox x:Name="ConnectionStringBox"
                         Grid.Row="0" Grid.Column="0"
                         PlaceholderText="Enter Storage Account connection string..."
                         Margin="0,0,12,8"
                         TextChanged="ConnectionStringBox_TextChanged" />
                
                <Button x:Name="ConnectButton"
                        Grid.Row="0" Grid.Column="1"
                        Content="Connect"
                        Click="ConnectButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Container:" 
                                   Foreground="{StaticResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ContainerComboBox"
                                  MinWidth="250"
                                  SelectionChanged="ContainerComboBox_SelectionChanged" />
                    </StackPanel>
                    
                    <Button x:Name="RefreshButton" 
                            Content="Refresh" 
                            Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>
        </controls:Expander>
        
        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>
            
            <!-- File Browser -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Breadcrumb Navigation -->
                <controls:BreadcrumbBar x:Name="PathBreadcrumb" 
                                        Grid.Row="0"
                                        Margin="0,0,0,12"
                                        ItemClicked="PathBreadcrumb_ItemClicked">
                </controls:BreadcrumbBar>
                
                <!-- File List -->
                <ListView x:Name="BlobsList"
                          Grid.Row="1"
                          Background="{StaticResource AppSurfaceBrush}"
                          CornerRadius="8"
                          SelectionChanged="BlobsList_SelectionChanged"
                          DoubleTapped="BlobsList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Grid.Column="0"
                                          Glyph="{Binding IsDirectory, Converter={StaticResource BlobIconConverter}}"
                                          Foreground="{StaticResource AppHighlightBrush}" />
                                
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                                
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"
                                           Foreground="{StaticResource AppSecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                                
                                <TextBlock Grid.Column="3" 
                                           Text="{Binding LastModified, Converter={StaticResource DateTimeConverter}}"
                                           Foreground="{StaticResource AppSecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            
            <!-- Preview Panel -->
            <Grid Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" CornerRadius="8" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Text="Preview" 
                           Grid.Row="0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Margin="0,0,0,12" />
                
                <!-- Properties -->
                <StackPanel x:Name="PropertiesPanel" Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                    <TextBlock x:Name="BlobNameText" 
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Size:" Foreground="{StaticResource AppSecondaryTextBrush}" />
                        <TextBlock x:Name="BlobSizeText" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Type:" Foreground="{StaticResource AppSecondaryTextBrush}" />
                        <TextBlock x:Name="BlobTypeText" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Modified:" Foreground="{StaticResource AppSecondaryTextBrush}" />
                        <TextBlock x:Name="BlobModifiedText" />
                    </StackPanel>
                </StackPanel>
                
                <!-- Content Preview -->
                <ScrollViewer Grid.Row="2">
                    <TextBlock x:Name="ContentPreviewText"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="12"
                               Foreground="{StaticResource AppTextBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Grid>
        
        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <ProgressRing x:Name="LoadingRing" 
                          IsActive="False" 
                          Width="20" 
                          Height="20"
                          Margin="0,0,12,0" />
            <TextBlock x:Name="StatusText" 
                       Grid.Column="1"
                       Foreground="{StaticResource AppSecondaryTextBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

