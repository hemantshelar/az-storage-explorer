<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AzStorageExplorer.Views.CosmosDbView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzStorageExplorer.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:AzStorageExplorer.Models">
    
    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <FontIcon Glyph="&#xE968;" FontSize="28" Foreground="{StaticResource AppHighlightBrush}" />
            <TextBlock Text="Cosmos DB Explorer" 
                       FontSize="24" 
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
        
        <!-- Connection Settings -->
        <controls:Expander Grid.Row="1" 
                           Header="Connection Settings" 
                           IsExpanded="True"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           Margin="0,0,0,16">
            <Grid Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBox x:Name="ConnectionStringBox"
                         Grid.Row="0" Grid.Column="0"
                         PlaceholderText="Enter Cosmos DB connection string..."
                         Margin="0,0,12,8"
                         TextChanged="ConnectionStringBox_TextChanged" />
                
                <Button x:Name="ConnectButton"
                        Grid.Row="0" Grid.Column="1"
                        Content="Connect"
                        Click="ConnectButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Database:" 
                                   Foreground="{StaticResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="DatabaseComboBox"
                                  MinWidth="200"
                                  SelectionChanged="DatabaseComboBox_SelectionChanged" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Container:" 
                                   Foreground="{StaticResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ContainerComboBox"
                                  MinWidth="200" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </controls:Expander>
        
        <!-- Queries Area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Queries Header with New Query button -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="Queries"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           VerticalAlignment="Center" />
                
                <Button Grid.Column="2"
                        Click="NewQueryButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New Query" />
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Background="{StaticResource AppSurfaceBrush}"
                          CornerRadius="8"
                          Padding="8">
                <StackPanel>
                    <!-- History of query results -->
                    <ItemsControl x:Name="ResultsHistoryList"
                                  ItemsSource="{Binding QueryHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QueryResultEntry">
                                <controls:Expander IsExpanded="False" Margin="0,0,0,8">
                                    <controls:Expander.Header>
                                        <StackPanel Orientation="Vertical" Spacing="2">
                                            <TextBlock Text="{x:Bind QueryText, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource AppSecondaryTextBrush}"
                                                       FontSize="12">
                                                <Run Text="{x:Bind Database, Mode=OneWay}" />
                                                <Run Text=" • " />
                                                <Run Text="{x:Bind Container, Mode=OneWay}" />
                                                <Run Text=" • " />
                                                <Run Text="{x:Bind ResultCount, Mode=OneWay}" />
                                                <Run Text=" items • RU " />
                                                <Run Text="{x:Bind RequestChargeFormatted, Mode=OneWay}" />
                                                <Run Text=" • " />
                                                <Run Text="{x:Bind ExecutedAtLocal, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </controls:Expander.Header>
                                    
                                    <StackPanel Spacing="8">
                                        <!-- Container selector -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Container:" 
                                                       Foreground="{StaticResource AppSecondaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBox x:Name="EntryContainerBox"
                                                     Text="{x:Bind Container, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="200"
                                                     PlaceholderText="Enter container name" />
                                        </StackPanel>
                                        
                                        <!-- Query editor -->
                                        <TextBox Text="{x:Bind QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="60"
                                                 FontFamily="Cascadia Code, Consolas, monospace" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Run"
                                                    Click="RunHistoryButton_Click"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="Save"
                                                    Click="SaveHistoryButton_Click"
                                                    Tag="{x:Bind}" />
                                            <Button Content="Delete"
                                                    Click="DeleteHistoryButton_Click"
                                                    Tag="{x:Bind}" />
                                        </StackPanel>
                                        <ScrollViewer Background="{StaticResource AppSurfaceBrush}"
                                                      Padding="8"
                                                      HorizontalScrollMode="Auto"
                                                      HorizontalScrollBarVisibility="Auto">
                                            <TextBlock Text="{x:Bind ResultsJson, Mode=OneWay}"
                                                       FontFamily="Cascadia Code, Consolas, monospace"
                                                       FontSize="13"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       TextWrapping="NoWrap"
                                                       IsTextSelectionEnabled="True" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </controls:Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <ProgressRing x:Name="LoadingRing" 
                          IsActive="False" 
                          Width="20" 
                          Height="20"
                          Margin="0,0,12,0" />
            <TextBlock x:Name="StatusText" 
                       Grid.Column="1"
                       Foreground="{StaticResource AppSecondaryTextBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

