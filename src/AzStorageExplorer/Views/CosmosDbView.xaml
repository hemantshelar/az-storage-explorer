<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AzStorageExplorer.Views.CosmosDbView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzStorageExplorer.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:AzStorageExplorer.Models">
    
    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <FontIcon Glyph="&#xE968;" FontSize="28" Foreground="{StaticResource AppHighlightBrush}" />
            <TextBlock Text="Cosmos DB Explorer" 
                       FontSize="24" 
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
        
        <!-- Connection Settings -->
        <controls:Expander x:Name="ConnectionSettingsExpander"
                           Grid.Row="1" 
                           Header="Connection Settings" 
                           IsExpanded="True"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           Margin="0,0,0,16">
            <Grid Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBox x:Name="ConnectionStringBox"
                         Grid.Row="0" Grid.Column="0"
                         PlaceholderText="Enter Cosmos DB connection string..."
                         Margin="0,0,12,8"
                         TextChanged="ConnectionStringBox_TextChanged" />
                
                <Button x:Name="ConnectButton"
                        Grid.Row="0" Grid.Column="1"
                        Content="Connect"
                        Click="ConnectButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Database:" 
                                   Foreground="{StaticResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="DatabaseComboBox"
                                  MinWidth="200"
                                  SelectionChanged="DatabaseComboBox_SelectionChanged" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Container:" 
                                   Foreground="{StaticResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ContainerComboBox"
                                  MinWidth="200" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </controls:Expander>
        
        <!-- Not Connected Message -->
        <Border Grid.Row="2" 
                Background="{StaticResource AppSurfaceBrush}"
                CornerRadius="8"
                Padding="40"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE774;" FontSize="48" Foreground="{StaticResource AppSecondaryTextBrush}" />
                <TextBlock Text="Connect to get started"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Enter your connection string above and click Connect to browse your Cosmos DB data."
                           Foreground="{StaticResource AppSecondaryTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="400" />
            </StackPanel>
        </Border>
        
        <!-- Queries Area - Only visible when connected -->
        <Grid Grid.Row="2" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Queries Header with New Query button -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="Queries"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           VerticalAlignment="Center" />
                
                <Button Grid.Column="2"
                        Click="NewQueryButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New Query" />
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Background="{StaticResource AppSurfaceBrush}"
                          CornerRadius="8"
                          Padding="12"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- Queries grouped by container -->
                <ItemsControl x:Name="GroupedQueriesList"
                              ItemsSource="{Binding GroupedQueries}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ContainerQueryGroup">
                            <!-- Container Group Expander -->
                            <controls:Expander IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" 
                                               Margin="0,0,0,12"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch">
                                <controls:Expander.Header>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE838;" FontSize="16" 
                                                  Foreground="{StaticResource AppHighlightBrush}" 
                                                  Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind ContainerName, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2" 
                                                Background="{StaticResource AppHighlightBrush}"
                                                CornerRadius="10"
                                                Padding="8,2">
                                            <TextBlock Text="{x:Bind QueryCount, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>
                                </controls:Expander.Header>
                                
                                <!-- Queries in this container -->
                                <ItemsControl ItemsSource="{x:Bind Queries, Mode=OneWay}"
                                              HorizontalAlignment="Stretch"
                                              Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel HorizontalAlignment="Stretch" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:QueryResultEntry">
                                            <!-- Individual Query Expander -->
                                            <controls:Expander IsExpanded="False" 
                                                               Margin="0,0,0,8"
                                                               HorizontalAlignment="Stretch"
                                                               HorizontalContentAlignment="Stretch">
                                                <controls:Expander.Header>
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <StackPanel Orientation="Vertical" Spacing="2">
                                                            <TextBlock Text="{x:Bind QueryText, Mode=OneWay}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AppTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Foreground="{StaticResource AppSecondaryTextBrush}"
                                                                       FontSize="12">
                                                                <Run Text="{x:Bind ResultCount, Mode=OneWay}" />
                                                                <Run Text=" items • RU " />
                                                                <Run Text="{x:Bind RequestChargeFormatted, Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{x:Bind ExecutedAtLocal, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </controls:Expander.Header>
                                
                                <Grid HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                        <!-- Container selector -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Container:" 
                                                       Foreground="{StaticResource AppSecondaryTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Width="80" />
                                            <TextBox Text="{x:Bind Container, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="250"
                                                     PlaceholderText="Enter container name" />
                                        </StackPanel>
                                        
                                        <!-- Query editor -->
                                        <TextBox Text="{x:Bind QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="80"
                                                 HorizontalAlignment="Stretch"
                                                 FontFamily="Cascadia Code, Consolas, monospace" />
                                        
                                        <!-- Action buttons and view toggle -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Action buttons -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <Button Content="Run"
                                                        Click="RunHistoryButton_Click"
                                                        Tag="{x:Bind}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        MinWidth="80" />
                                                <Button Content="Save"
                                                        Click="SaveHistoryButton_Click"
                                                        Tag="{x:Bind}"
                                                        MinWidth="80" />
                                                <Button Content="Delete"
                                                        Click="DeleteHistoryButton_Click"
                                                        Tag="{x:Bind}"
                                                        MinWidth="80" />
                                            </StackPanel>
                                            
                                            <!-- View toggle -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                <Button Click="JsonViewButton_Click"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="JSON View"
                                                        Padding="8,6">
                                                    <FontIcon Glyph="&#xE943;" FontSize="16" />
                                                </Button>
                                                <Button Click="TableViewButton_Click"
                                                        Tag="{x:Bind}"
                                                        IsEnabled="{x:Bind CanShowAsTable, Mode=OneWay}"
                                                        ToolTipService.ToolTip="Table View (available for flat data)"
                                                        Padding="8,6">
                                                    <FontIcon Glyph="&#xE80A;" FontSize="16" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- Results area - JSON View -->
                                        <Border Background="{StaticResource AppBackgroundBrush}"
                                                CornerRadius="6"
                                                Padding="12"
                                                MinHeight="100"
                                                MaxHeight="400"
                                                Visibility="{x:Bind ShowJsonView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ScrollViewer HorizontalScrollMode="Auto"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{x:Bind ResultsJson, Mode=OneWay}"
                                                           FontFamily="Cascadia Code, Consolas, monospace"
                                                           FontSize="13"
                                                           Foreground="{StaticResource AppTextBrush}"
                                                           TextWrapping="NoWrap"
                                                           IsTextSelectionEnabled="True" />
                                            </ScrollViewer>
                                        </Border>
                                        
                                        <!-- Results area - Table View -->
                                        <Border Background="{StaticResource AppBackgroundBrush}"
                                                CornerRadius="6"
                                                MinHeight="100"
                                                MaxHeight="400"
                                                Visibility="{x:Bind ShowTableView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ScrollViewer HorizontalScrollMode="Auto"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <!-- Table Header -->
                                                    <Border Background="{StaticResource AppSurfaceBrush}"
                                                            BorderBrush="{StaticResource AppBorderBrush}"
                                                            BorderThickness="0,0,0,2"
                                                            Padding="4">
                                                        <ItemsControl ItemsSource="{x:Bind TableColumns, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border Width="150" Padding="8,6">
                                                                        <TextBlock Text="{x:Bind}" 
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource AppTextBrush}"
                                                                                   FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTipService.ToolTip="{x:Bind}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                    
                                                    <!-- Table Rows -->
                                                    <ItemsControl ItemsSource="{x:Bind TableRows, Mode=OneWay}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource AppBorderBrush}"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="4"
                                                                        Background="Transparent">
                                                                    <ItemsControl ItemsSource="{Binding Values}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Width="150" Padding="8,6">
                                                                                    <TextBlock Text="{Binding}" 
                                                                                               Foreground="{StaticResource AppTextBrush}"
                                                                                               FontSize="12"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               IsTextSelectionEnabled="True"
                                                                                               ToolTipService.ToolTip="{Binding}" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </controls:Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                            </controls:Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        
        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <ProgressRing x:Name="LoadingRing" 
                          IsActive="False" 
                          Width="20" 
                          Height="20"
                          Margin="0,0,12,0" />
            <TextBlock x:Name="StatusText" 
                       Grid.Column="1"
                       Foreground="{StaticResource AppSecondaryTextBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

