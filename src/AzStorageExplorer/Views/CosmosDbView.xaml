<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AzStorageExplorer.Views.CosmosDbView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzStorageExplorer.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    
    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <FontIcon Glyph="&#xE968;" FontSize="28" Foreground="{StaticResource AppHighlightBrush}" />
            <TextBlock Text="Cosmos DB Explorer" 
                       FontSize="24" 
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
        
        <!-- Connection Settings -->
        <controls:Expander Grid.Row="1" 
                           Header="Connection Settings" 
                           IsExpanded="True"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           Margin="0,0,0,16">
            <Grid Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBox x:Name="ConnectionStringBox"
                         Grid.Row="0" Grid.Column="0"
                         PlaceholderText="Enter Cosmos DB connection string..."
                         Margin="0,0,12,8"
                         TextChanged="ConnectionStringBox_TextChanged" />
                
                <Button x:Name="ConnectButton"
                        Grid.Row="0" Grid.Column="1"
                        Content="Connect"
                        Click="ConnectButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Database:" 
                                   Foreground="{StaticResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="DatabaseComboBox"
                                  MinWidth="200"
                                  SelectionChanged="DatabaseComboBox_SelectionChanged" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Container:" 
                                   Foreground="{StaticResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ContainerComboBox"
                                  MinWidth="200" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </controls:Expander>
        
        <!-- Query Section -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            
            <!-- Query Editor -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <TextBlock Text="SQL Query" 
                           Grid.Row="0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Margin="0,0,0,8" />
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="QueryTextBox"
                             Grid.Column="0"
                             Text="SELECT * FROM c"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80"
                             MaxHeight="150"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Margin="0,0,12,0" />
                    
                    <StackPanel Grid.Column="1" Spacing="8">
                        <Button x:Name="ExecuteButton"
                                Content="Execute"
                                Click="ExecuteButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="100" />
                        <Button x:Name="SaveQueryButton"
                                Content="Save Query"
                                Click="SaveQueryButton_Click"
                                MinWidth="100" />
                    </StackPanel>
                </Grid>
            </Grid>
            
            <!-- Saved Queries Panel -->
            <Grid Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" CornerRadius="8" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Text="Saved Queries" 
                           Grid.Row="0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           Margin="0,0,0,12" />
                
                <ListView x:Name="SavedQueriesList"
                          Grid.Row="1"
                          SelectionChanged="SavedQueriesList_SelectionChanged"
                          MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Container}" 
                                               FontSize="12" 
                                               Foreground="{StaticResource AppSecondaryTextBrush}" />
                                </StackPanel>
                                
                                <Button Grid.Column="1"
                                        Content="&#xE74D;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Background="Transparent"
                                        Click="DeleteQueryButton_Click"
                                        Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        
        <!-- Results Area -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
                <TextBlock Text="Results" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ResultCountText" 
                           Foreground="{StaticResource AppSecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="RequestChargeText" 
                           Foreground="{StaticResource AppSecondaryTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            
            <ScrollViewer Grid.Row="1" 
                          Background="{StaticResource AppSurfaceBrush}" 
                          CornerRadius="8"
                          Padding="12">
                <TextBlock x:Name="ResultsTextBlock"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="13"
                           Foreground="{StaticResource AppTextBrush}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Grid>
        
        <!-- Status Bar -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <ProgressRing x:Name="LoadingRing" 
                          IsActive="False" 
                          Width="20" 
                          Height="20"
                          Margin="0,0,12,0" />
            <TextBlock x:Name="StatusText" 
                       Grid.Column="1"
                       Foreground="{StaticResource AppSecondaryTextBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

